{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug keyrigme-back",
      "cwd": "${workspaceFolder}/apps/keyrigme-back",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "--env-file-if-exists=.env", "src/main.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
